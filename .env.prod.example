# C-15: plantilla de entorno de PRODUCCION (Easypanel, compose.prod.yml).
# Pegar en el editor de entorno (reemplaza el .env.example de dev) y activar "Create .env file".
# Datos 100 % ficticios. Secretos: openssl rand -hex 32
DOMAIN=turnos.example.com
POSTGRES_USER=turnos
POSTGRES_PASSWORD=<cambiar-openssl-rand-hex-32>
POSTGRES_DB=turnos
JWT_SECRET=<cambiar-openssl-rand-hex-32>
JWT_EXPIRE_MIN=30
CORS_ORIGINS=["https://turnos.example.com"]
UVICORN_WORKERS=2
WHATSAPP_MOCK=true
TZ=America/Argentina/Buenos_Aires
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<cambiar-password-admin>
VITE_API_URL=https://api.turnos.example.com
